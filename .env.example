# ---------------------------------------------------------------------------
# Plantilla de configuracion. Copie este archivo como .env y rellenelo.
#
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux / macOS)
#
# El .env real NUNCA se sube al repositorio: contiene secretos.
# ---------------------------------------------------------------------------

# Cadena larga y aleatoria. Genere una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria

# True solo en desarrollo. En produccion SIEMPRE False.
DEBUG=True

# Dominios permitidos, separados por comas.
# En produccion: midominio.com,www.midominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Origenes de confianza para CSRF. Obligatorio en produccion con HTTPS.
# Ejemplo: https://midominio.com,https://www.midominio.com
CSRF_TRUSTED_ORIGINS=

# Ponga False MIENTRAS el servidor no tenga certificado (acceso por IP).
# Desactiva en bloque la redireccion a HTTPS, las cookies seguras y HSTS: con
# cookies seguras sobre HTTP el navegador no las envia y no se puede entrar.
# En cuanto tenga dominio y certificado, quitelo o pongalo a True.
SECURE_SSL_REDIRECT=True

# Muestra las cuentas de prueba en la pantalla de acceso, para que cualquiera
# pueda probar el sistema. Util en una demostracion o en la defensa del
# proyecto. En uso real: False, y cambie las contrasenas.
MOSTRAR_CUENTAS_DEMO=True

# ---------------------------------------------------------------------------
# Base de datos (MySQL / MariaDB)
# ---------------------------------------------------------------------------
DB_NAME=baches_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------------------------------
# Modelo de deteccion
# ---------------------------------------------------------------------------
# Archivo dentro de ai_models/
YOLO_MODEL=detector_baches_v2_bache_grieta.pt
# Umbral de confianza: por debajo de este valor la deteccion se descarta
YOLO_CONF=0.35

# ---------------------------------------------------------------------------
# Mapas
# ---------------------------------------------------------------------------
# Opcional. Con clave se usa Google Maps; sin ella, OpenStreetMap.
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=

# Identificador propio ante Nominatim (su politica de uso lo exige).
NOMINATIM_USER_AGENT=detector-baches-juliaca-puno
