# Normaliza los finales de linea: en el repositorio siempre LF, en Windows
# CRLF al trabajar. Evita que un mismo archivo aparezca como modificado solo
# por cambiar de sistema operativo.
* text=auto eol=lf

# Archivos binarios: git no debe tocarlos
*.pt      binary
*.jpg     binary
*.jpeg    binary
*.png     binary
*.webp    binary
*.mp4     binary
*.webm    binary
*.ico     binary
